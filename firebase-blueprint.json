{
  "entities": {
    "Medicine": {
      "title": "Medicine Monograph",
      "description": "Bilingual evidence-based educational medicine reference entry with traceable medical review dates and sources.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 2, "maxLength": 120, "pattern": "^[a-z0-9-]+$" },
        "nameEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "nameHi": { "type": "string", "minLength": 1, "maxLength": 200 },
        "genericName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "brandNames": { "type": "array", "description": "Common Indian reference brand names (max 10)." },
        "drugCategory": { "type": "string", "minLength": 2, "maxLength": 100 },
        "therapeuticCategory": { "type": "string", "minLength": 2, "maxLength": 100 },
        "classificationEn": { "type": "string", "minLength": 2, "maxLength": 240 },
        "classificationHi": { "type": "string", "minLength": 1, "maxLength": 300 },
        "usesEn": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "usesHi": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "mechanismEn": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "mechanismHi": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "sideEffectsEn": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "sideEffectsHi": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "precautionsEn": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "precautionsHi": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "contraindicationsEn": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "contraindicationsHi": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "storageEn": { "type": "string", "minLength": 5, "maxLength": 800 },
        "storageHi": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "references": { "type": "array", "description": "Authoritative reference sources (max 10)." },
        "reviewDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "published": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "slug",
        "nameEn",
        "nameHi",
        "genericName",
        "brandNames",
        "drugCategory",
        "therapeuticCategory",
        "classificationEn",
        "classificationHi",
        "usesEn",
        "usesHi",
        "mechanismEn",
        "mechanismHi",
        "sideEffectsEn",
        "sideEffectsHi",
        "precautionsEn",
        "precautionsHi",
        "contraindicationsEn",
        "contraindicationsHi",
        "storageEn",
        "storageHi",
        "references",
        "reviewDate",
        "published",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Article": {
      "title": "Health Awareness Article",
      "description": "Bilingual health awareness blog post with references, category, and SEO metadata.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 2, "maxLength": 140, "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "titleEn": { "type": "string", "minLength": 5, "maxLength": 200 },
        "titleHi": { "type": "string", "minLength": 3, "maxLength": 240 },
        "summaryEn": { "type": "string", "minLength": 10, "maxLength": 600 },
        "summaryHi": { "type": "string", "minLength": 10, "maxLength": 700 },
        "contentEn": { "type": "string", "minLength": 40, "maxLength": 20000 },
        "contentHi": { "type": "string", "minLength": 40, "maxLength": 24000 },
        "featuredImage": { "type": "string", "minLength": 1, "maxLength": 500 },
        "author": { "type": "string", "minLength": 2, "maxLength": 100 },
        "publishedDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "lastUpdatedDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "readMinutes": { "type": "number" },
        "references": { "type": "array", "description": "Authoritative medical sources (max 12)." },
        "published": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "slug",
        "category",
        "titleEn",
        "titleHi",
        "summaryEn",
        "summaryHi",
        "contentEn",
        "contentHi",
        "featuredImage",
        "author",
        "publishedDate",
        "lastUpdatedDate",
        "readMinutes",
        "references",
        "published",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "PharmacyNote": {
      "title": "Pharmacy Study Resource",
      "description": "Original bilingual D.Pharm and pharmacy student study notes, definitions, practical procedures, and PDF links.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 2, "maxLength": 140, "pattern": "^[a-z0-9-]+$" },
        "subject": { "type": "string", "minLength": 2, "maxLength": 100 },
        "languageLabel": { "type": "string", "enum": ["Bilingual (EN + हिंदी)", "English", "हिंदी"] },
        "titleEn": { "type": "string", "minLength": 4, "maxLength": 200 },
        "titleHi": { "type": "string", "minLength": 3, "maxLength": 240 },
        "shortNotesEn": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "shortNotesHi": { "type": "string", "minLength": 10, "maxLength": 3500 },
        "detailedNotesEn": { "type": "string", "minLength": 20, "maxLength": 15000 },
        "detailedNotesHi": { "type": "string", "minLength": 20, "maxLength": 18000 },
        "definitionsEn": { "type": "string", "maxLength": 4000 },
        "definitionsHi": { "type": "string", "maxLength": 4500 },
        "practicalProcedureEn": { "type": "string", "maxLength": 6000 },
        "practicalProcedureHi": { "type": "string", "maxLength": 7000 },
        "diagramKey": { "type": "string", "maxLength": 80 },
        "pdfUrl": { "type": "string", "maxLength": 500 },
        "published": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "slug",
        "subject",
        "languageLabel",
        "titleEn",
        "titleHi",
        "shortNotesEn",
        "shortNotesHi",
        "detailedNotesEn",
        "detailedNotesHi",
        "definitionsEn",
        "definitionsHi",
        "practicalProcedureEn",
        "practicalProcedureHi",
        "diagramKey",
        "pdfUrl",
        "published",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Healthcare Product Catalogue Item",
      "description": "Informational healthcare equipment or essential product entry (no restricted medicine ordering).",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 2, "maxLength": 140, "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string", "minLength": 2, "maxLength": 100 },
        "nameEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "nameHi": { "type": "string", "minLength": 2, "maxLength": 200 },
        "image": { "type": "string", "minLength": 1, "maxLength": 500 },
        "descriptionEn": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "descriptionHi": { "type": "string", "minLength": 10, "maxLength": 3500 },
        "featuresEn": { "type": "array", "description": "Key product features in English (max 10)." },
        "featuresHi": { "type": "array", "description": "Key product features in Hindi (max 10)." },
        "usageEn": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "usageHi": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "precautionsEn": { "type": "string", "minLength": 10, "maxLength": 2500 },
        "precautionsHi": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "published": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "slug",
        "category",
        "nameEn",
        "nameHi",
        "image",
        "descriptionEn",
        "descriptionHi",
        "featuresEn",
        "featuresHi",
        "usageEn",
        "usageHi",
        "precautionsEn",
        "precautionsHi",
        "published",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Managed Content Category",
      "description": "Taxonomy entry for Medicine Library, Health Blog, Pharmacy Education, or Healthcare Products.",
      "type": "object",
      "properties": {
        "domain": { "type": "string", "enum": ["medicine", "blog", "pharmacy", "product"] },
        "nameEn": { "type": "string", "minLength": 2, "maxLength": 100 },
        "nameHi": { "type": "string", "minLength": 1, "maxLength": 120 },
        "published": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["domain", "nameEn", "nameHi", "published", "updatedBy", "createdAt", "updatedAt"]
    },
    "Enquiry": {
      "title": "Contact or Product Enquiry",
      "description": "Visitor contact form or product enquiry submission containing PII — strictly admin-readable only.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 24 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 180 },
        "message": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "sourceType": { "type": "string", "enum": ["contact", "product_enquiry"] },
        "consentAccepted": { "type": "boolean" },
        "status": { "type": "string", "enum": ["new", "reviewed", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "subject", "message", "sourceType", "consentAccepted", "status", "createdAt"]
    },
    "SiteSettings": {
      "title": "Site Contact & SEO Configuration",
      "description": "Publicly readable SEO metadata, analytics tracking ID, and official Ved's Medcare contact details.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "founderName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 7, "maxLength": 30 },
        "whatsapp": { "type": "string", "minLength": 7, "maxLength": 30 },
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "locationEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "locationHi": { "type": "string", "minLength": 2, "maxLength": 200 },
        "instagramHandle": { "type": "string", "minLength": 2, "maxLength": 80 },
        "instagramUrl": { "type": "string", "minLength": 10, "maxLength": 240 },
        "seoTitleEn": { "type": "string", "minLength": 5, "maxLength": 120 },
        "seoTitleHi": { "type": "string", "minLength": 5, "maxLength": 150 },
        "seoDescriptionEn": { "type": "string", "minLength": 10, "maxLength": 260 },
        "seoDescriptionHi": { "type": "string", "minLength": 10, "maxLength": 300 },
        "googleAnalyticsId": { "type": "string", "maxLength": 40 },
        "googleSearchConsoleCode": { "type": "string", "maxLength": 120 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "brandName",
        "founderName",
        "phone",
        "whatsapp",
        "email",
        "locationEn",
        "locationHi",
        "instagramHandle",
        "instagramUrl",
        "seoTitleEn",
        "seoTitleHi",
        "seoDescriptionEn",
        "seoDescriptionHi",
        "googleAnalyticsId",
        "googleSearchConsoleCode",
        "updatedBy",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "Admin RBAC Entry",
      "description": "Authorized administrator role document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "role": { "type": "string", "enum": ["super_admin", "editor"] },
        "addedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "addedBy", "createdAt"]
    },
    "Review": {
      "title": "Reader & Student Testimonial Review",
      "description": "Moderated reader and D.Pharm student reviews displayed in the homepage carousel when approved.",
      "type": "object",
      "properties": {
        "reviewerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "roleEn": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roleHi": { "type": "string", "maxLength": 150 },
        "rating": { "type": "integer" },
        "textEn": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "textHi": { "type": "string", "maxLength": 1400 },
        "avatarColor": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^#[0-9A-Fa-f]{6}$" },
        "approved": { "type": "boolean" },
        "createdDate": { "type": "string", "minLength": 4, "maxLength": 24 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "reviewerName",
        "roleEn",
        "roleHi",
        "rating",
        "textEn",
        "textHi",
        "avatarColor",
        "approved",
        "createdDate",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/medicines/{medicineId}": {
      "schema": { "$ref": "#/entities/Medicine" },
      "description": "Published medicines are publicly readable; drafts and all writes require verified Admin."
    },
    "/articles/{articleId}": {
      "schema": { "$ref": "#/entities/Article" },
      "description": "Published health awareness articles are publicly readable; drafts and writes require verified Admin."
    },
    "/pharmacyNotes/{noteId}": {
      "schema": { "$ref": "#/entities/PharmacyNote" },
      "description": "Published D.Pharm study notes are publicly readable; drafts and writes require verified Admin."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Published healthcare product catalogue items are publicly readable; writes require verified Admin."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Published content categories are publicly readable; writes require verified Admin."
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "Visitor contact and product enquiries. Public create with strict schema + consent; read/update/delete restricted strictly to Admin (PII isolation)."
    },
    "/siteSettings/{settingsId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global site settings & SEO config ('global' doc). Public get, Admin write."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "RBAC admin registry. Strictly readable by self or Admin; writable only by verified Admin."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Approved reader & student testimonials are publicly readable; unapproved reviews and all writes require verified Admin."
    }
  }
}
